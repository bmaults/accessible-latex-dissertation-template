\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ncsu-accessibility}[2026/07/22 Accessibility helpers for NC State ETDs]

%%----------------------------------------------------------------------------%%
%% Package dependencies
%%----------------------------------------------------------------------------%%
%% These packages support the accessible figure, link, reminder, and table
%% workflows used by the dissertation template.

\RequirePackage{graphicx}
\RequirePackage{xparse}
\RequirePackage{booktabs}
\RequirePackage{longtable}
\RequirePackage{tabularx}
\RequirePackage{array}
\RequirePackage{caption}

%%----------------------------------------------------------------------------%%
%% Accessible figure helpers
%%----------------------------------------------------------------------------%%

% Figure helper requiring alt text.
% Usage:
% \accessiblefigure[placement][width]{file}{alt text}{caption}{label}
\NewDocumentCommand{\accessiblefigure}{O{htbp} O{\textwidth} m m m m}{%
  \begin{figure}[#1]
    \centering
    \includegraphics[width=#2,alt={#4}]{#3}%
    \caption{#5}%
    \label{#6}%
  \end{figure}%
}

% Cropped figure helper requiring alt text.
% Usage:
% \accessiblefigurecropped[placement][width]
%   {trim spec}{file}{alt text}{caption}{label}
\NewDocumentCommand{\accessiblefigurecropped}{O{htbp} O{\textwidth} m m m m m}{%
  \begin{figure}[#1]
    \centering
    \includegraphics[trim={#3},clip,width=#2,alt={#5}]{#4}%
    \caption{#6}%
    \label{#7}%
  \end{figure}%
}

%%----------------------------------------------------------------------------%%
%% Accessible link helper
%%----------------------------------------------------------------------------%%
%% Use this for short, descriptive links. Avoid raw URLs in body text.
%% Usage:
%% \accesslink{https://example.edu}{descriptive link text}

\NewDocumentCommand{\accesslink}{m m}{%
  \href{#1}{#2}%
}

%%----------------------------------------------------------------------------%%
%% Author reminder helper
%%----------------------------------------------------------------------------%%
%% This reminder is intentionally visible in draft output. Remove all resolved
%% reminders before the dissertation is submitted.

\NewDocumentCommand{\accessibilitytodo}{m}{%
  \par
  \noindent
  \fbox{%
    \begin{minipage}{0.95\linewidth}
      \textbf{Accessibility reminder:} #1
    \end{minipage}%
  }%
  \par
}

%%----------------------------------------------------------------------------%%
%% Visual document formatting
%%----------------------------------------------------------------------------%%
%% Required NC State chapter and heading formatting belongs in ncsuthesis.cls.
%% This package intentionally does not redefine chapter or section commands.

\endinput
